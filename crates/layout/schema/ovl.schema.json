              "$ref": "#/$defs/BorderOpt"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "type": "array"
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "description": "[x, y] from the anchor in layout units (positive = right/down). Default [0, 0].",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "opacity": {
          "description": "0..=1, multiplies down the tree. Default 1.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "radius": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "size": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "visible": {
          "description": "Default true.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "size"
      ],
      "type": "object"
    },
    "GpsLockIconNode": {
