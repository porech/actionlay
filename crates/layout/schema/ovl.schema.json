{
  "$defs": {
    "Anchor": {
      "description": "One of the 9 points of a box a node is attached to.",
      "enum": [
        "top-left",
        "top",
        "top-right",
        "left",
        "center",
        "right",
        "bottom-left",
        "bottom",
        "bottom-right"
      ],
      "type": "string"
    },
    "Aspect": {
      "description": "Design aspect ratio W:H, e.g. \"16:9\"",
      "pattern": "^[0-9]+(\\.[0-9]+)?:[0-9]+(\\.[0-9]+)?$",
      "type": "string"
    },
    "BorderOpt": {
      "additionalProperties": true,
      "properties": {
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Color": {
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "type": "string"
    },
    "ColorRef": {
      "pattern": "^(primary|secondary|accent|panel|#([0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$",
      "type": "string"
    },
    "DateZone": {
      "oneOf": [
        {
          "enum": [
            "utc"
          ],
          "type": "string"
        },
        {
          "const": "local",
          "description": "Time zone of the machine (M2; per-video zones come later).",
          "type": "string"
        }
      ]
    },
    "DatetimeNode": {
      "additionalProperties": true,
      "description": "Parameters every node has.",
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Anchor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Default: top-left."
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColorRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "font": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "description": "strftime, default \"%H:%M:%S\".",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "description": "[x, y] from the anchor in layout units (positive = right/down). Default [0, 0].",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "opacity": {
          "description": "0..=1, multiplies down the tree. Default 1.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "outline": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutlineOpt"
            },
            {
              "type": "null"
            }
          ]
        },
        "shadow": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShadowOpt"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "description": "Font size = height of the text box, in layout units.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "timezone": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateZone"
            },
            {
              "type": "null"
            }
          ]
        },
        "visible": {
          "description": "Default true.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "weight": {
          "anyOf": [
            {
              "$ref": "#/$defs/FontWeight"
            },
            {
              "type": "null"
            }
          ]
        },
        "when_absent": {
          "anyOf": [
            {
              "$ref": "#/$defs/WhenAbsent"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "FontWeight": {
      "enum": [
        "regular",
        "medium",
        "bold"
      ],
      "type": "string"
    },
    "FrameNode": {
      "additionalProperties": true,
      "description": "Group with a size, a background panel, a border and rounded corners.",
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Anchor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Default: top-left."
        },
        "border": {
          "anyOf": [
